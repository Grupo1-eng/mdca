DATABASE_URL=
PORT=3000

# Obrigatório: sem ele a aplicação não sobe. Gere com: openssl rand -base64 48
JWT_SECRET=
# Validade do token em segundos (padrão: 28800 = 8h)
JWT_EXPIRES_IN=28800

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Rate limit do login: tentativas por janela para cada par IP + e-mail
# (padrão: 5 por 60000 ms). O cadastro tem limite próprio fixo: 3 por minuto.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_TTL=60000

# Número de proxies na frente da aplicação (ex.: 1 no Render/Railway).
TRUST_PROXY=